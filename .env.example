# Visit notification webhook URL (required)
# Example: Discord webhook / Pipedream endpoint / your own backend endpoint
VITE_VISIT_NOTIFY_ENDPOINT=

# Optional shared token your webhook can validate
VITE_VISIT_NOTIFY_TOKEN=

# Anthropic Claude API key for /api/claude (set this in .env.local and Vercel env vars)
ANTHROPIC_API_KEY=
